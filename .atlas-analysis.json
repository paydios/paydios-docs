  "keyFeatures": [
    "Global payment acceptance across 135+ currencies and 20+ card providers",
    "Hosted checkout pages and embeddable payment links",
    "Recurring billing and subscription management",
    "Automated invoicing with smart reminders and auto-reconciliation",
    "Merchant payouts with next-day settlement",
    "Built-in fraud detection and chargeback dispute management",
    "PCI DSS Level 1 compliant infrastructure",
    "REST API with PHP SDK and Laravel support",
    "Real-time merchant dashboard with analytics",
    "Multi-currency support including crypto (BTC, ETH, USDT) and local rails (PIX, SEPA)"
