{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Paydios",
  "theme": "luma",
  "colors": {
    "primary": "#D4FF00",
    "light": "#A0C000",
    "dark": "#D4FF00"
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://paydios.io"
  },
  "fonts": {
    "family": "Comfortaa",
    "heading": {
      "family": "Poppins",
      "weight": 600
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "quickstart",
              "authentication"
            ]
          },
          {
            "group": "Core Features",
            "pages": [
              "accept-payments",
              "payment-links",
              "subscriptions",
              "invoicing",
              "payouts"
            ]
          },
          {
            "group": "Merchant Account",
            "pages": [
              "merchant-id",
              "merchant-api-keys",
              "customers",
              "transactions",
              "disputes"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "integrations/php",
              "integrations/laravel",
              "integrations/wordpress"
            ]
          },
          {
            "group": "Platform & Security",
            "pages": [
              "security",
              "pricing"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "https://www.paydios.io/contact"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://merchant.paydios.io/"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/paydios",
      "github": "https://github.com/paydios",
      "linkedin": "https://www.linkedin.com/company/paydios-io"
    },
    "links": [
      {
        "header": "Product",
        "items": [
          { "label": "Dashboard", "href": "https://merchant.paydios.io/" },
          { "label": "Documentation", "href": "/" },
          { "label": "Support", "href": "mailto:help@paydios.io" }
        ]
      },
      {
        "header": "Community",
        "items": [
          { "label": "GitHub", "href": "https://github.com/paydios" }
        ]
      }
    ]
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "background": {
    "decoration": "gradient"
  },
  "seo": {
    "metatags": {
      "description": "Build with Paydios payment infrastructure for global cards, wallets, crypto, subscriptions, invoicing, and payouts.",
      "og:site_name": "Paydios Documentation",
      "theme-color": "#D4FF00"
    }
  }
}
