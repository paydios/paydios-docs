{
  "$schema": "https://mintlify.com/docs.json",
  "name": "PkPay+",
  "theme": "luma",
  "colors": {
    "primary": "#081028",
    "light": "#7c7c7c",
    "dark": "#c9c9c9"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "quickstart",
              "authentication"
            ]
          },
          {
            "group": "Core Features",
            "pages": [
              "accept-payments",
              "payment-links",
              "subscriptions",
              "invoicing",
              "payouts"
            ]
          },
          {
            "group": "Merchant Account",
            "pages": [
              "merchant-id",
              "merchant-api-keys",
              "customers",
              "transactions",
              "disputes"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "integrations/php",
              "integrations/laravel",
              "integrations/wordpress"
            ]
          },
          {
            "group": "Platform & Security",
            "pages": [
              "security",
              "pricing"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@pkpayplus.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://merchant.pkpayplus.com/"
    }
  },
  "footer": {
    "links": [
      {
        "header": "Product",
        "items": [
          { "label": "Dashboard", "href": "https://merchant.pkpayplus.com/" },
          { "label": "Documentation", "href": "/" },
          { "label": "Support", "href": "mailto:support@pkpayplus.com" }
        ]
      },
      {
        "header": "Community",
        "items": [
          { "label": "GitHub", "href": "https://github.com/pkpayplus" }
        ]
      }
    ]
  },
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "background": {
    "decoration": "grid"
  }
}
